        string emp_type
        int manager_id FK
        int project_id FK
        float planned_days
        float carry_over
        bool is_active
    }
    vacation_requests {
        int id PK
        int employee_id FK
        date start_date
        date end_date
        string type
        string status
        bool pending_deletion
        date change_from_start
        date change_from_end
        int created_by
