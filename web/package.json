{
  "name": "vacation-planner-web",
  "version": "0.2.0",
  "private": true,
  "description": "Планировщик отпусков — веб-клиент (Vue 3 + TypeScript + Vite)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run",
    "sbom": "cyclonedx-npm -o ../sbom/web.cdx.json --sv 1.5 --flatten-components --output-reproducible --package-lock-only"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@tsconfig/node20": "^20.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
