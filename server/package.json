{
  "name": "vacation-planner-server",
  "version": "1.0.0",
  "private": true,
  "description": "Планировщик отпусков — API-сервер (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test prisma --ext .ts",
    "sbom": "cyclonedx-npm -o ../sbom/server.cdx.json --sv 1.5 --flatten-components --output-reproducible --package-lock-only",
    "build:seed": "tsc -p tsconfig.seed.json",
    "db:seed:prod": "node dist-seed/prisma/seed.js",
    "db:seed:load": "tsx prisma/load-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.2.1",
    "prisma": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "js-yaml": "5.5.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0"
  }
}
