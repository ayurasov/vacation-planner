# Скопируйте в server/.env для локальной разработки (в git не попадает).
# PostgreSQL из docker-compose.yml:
DATABASE_URL=postgresql://vacation:vacation@localhost:5432/vacation
PORT=8080
# Обязательно: случайная строка не короче 32 символов
JWT_SECRET=change-me-change-me-change-me-32ch
# Плановые задачи — извещения о начале отпуска, эскалация, напоминания о планировании (по умолчанию 60 с)
# JOBS_POLL_SECONDS=60

# Почта (необязательно). Без SMTP_HOST письма не отправляются — уведомления только в интерфейсе.
# SMTP_HOST=smtp.company.ru
# SMTP_PORT=587
# SMTP_SECURE=false        # true — TLS сразу (порт 465), false — STARTTLS
# SMTP_USER=vacation-planner
# SMTP_PASSWORD=
# MAIL_FROM=Планировщик отпусков <otpusk@company.ru>
# APP_URL=https://otpusk.company.ru   # ссылки в письмах

# Единый вход (необязательно): OpenID Connect. Адрес возврата у провайдера: ${APP_URL}/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://sso.company.ru/realms/corp
# OIDC_CLIENT_ID=vacation-planner
# OIDC_CLIENT_SECRET=
# OIDC_LOGIN_CLAIM=preferred_username   # ADFS: upn; логин — часть до «@» или после «\»
# OIDC_LABEL=корпоративную учётную запись
# LOCAL_LOGIN=true                      # false — пароль только у администраторов (аварийный вход)
