flowchart TB
  classDef client fill:#f2f5ff,stroke:#4f7cff,color:#1d2433
  classDef box fill:#f2f5ff,stroke:#4f7cff,stroke-width:1.5px,color:#1d2433
  classDef db fill:#effaf4,stroke:#22a06b,stroke-width:1.5px,color:#1d2433
  classDef ext fill:#f6f7fa,stroke:#a9b3c7,color:#1d2433
  classDef opt fill:#ffffff,stroke:#a9b3c7,stroke-dasharray:5 4,color:#1d2433

  U["Браузер сотрудника<br/><small>SPA Vue 3, токен доступа в памяти,<br/>refresh — httpOnly-cookie, поток событий SSE</small>"]:::client

  subgraph HOST["Сервер#nbsp;организации#nbsp;·#nbsp;Linux,#nbsp;Docker#nbsp;Engine#nbsp;+#nbsp;Compose"]
    RP["<b>Обратный прокси с TLS</b><br/><small>nginx / Caddy организации · :443 → web:80</small>"]:::ext
    subgraph NET["docker#nbsp;compose:#nbsp;проект#nbsp;vacation‑planner"]
      WEB["<b>web</b> · nginx 1.27<br/><small>статика SPA, CSP, кеш ассетов, gzip;<br/>/api → server:8080, поток событий без буфера;<br/>адрес server — заново каждые 10 с</small>"]:::box
      API["<b>server</b> · Node.js 20, NestJS 11<br/><small>REST API v1 (58 операций), поток событий,<br/>WEB_CONCURRENCY процессов, кэш графика,<br/>/metrics, миграции Prisma при старте</small>"]:::box
      DB[("<b>postgres</b> · PostgreSQL 17<br/><small>данные, лимит входа, версия данных,<br/>очередь писем; архив WAL</small>")]:::db
      BK["<b>backup</b> · postgres:17-alpine<br/><small>pg_dump раз в сутки,<br/>ротация копий</small>"]:::ext
      REP[("<b>postgres-replica</b> · PostgreSQL 17<br/><small>горячий резерв по слоту;<br/>при аварии — основной</small>")]:::opt
      BB["<b>basebackup</b><br/><small>физические копии,<br/>очистка архива WAL</small>"]:::opt
      PR["<b>prometheus</b><br/><small>сбор /metrics,<br/>оповещения</small>"]:::opt
    end
    VOL[("Тома Docker<br/><small>db-data · db-backups ·<br/>db-replica · wal-archive</small>")]:::db
  end

  U -- "HTTPS 443" --> RP
  RP -- "HTTP" --> WEB
  WEB -- "HTTP /api/*" --> API
  API -- "SQL (Prisma 6, пул на процесс)" --> DB
  BK -- "pg_dump" --> DB
  DB -. "поток WAL" .-> REP
  BB -. "pg_basebackup" .-> DB
  PR -. "/metrics" .-> API
  DB --- VOL
  BK --- VOL
