erDiagram
  employees |o--o{ audit_events : "актор"
  employees ||--o{ refresh_tokens : "сессии"
  employees |o--o{ email_outbox : "получатель"
  audit_events {
    int id PK
    timestamp ts
    int actor_id FK
    string action "request.approved, employee.updated ..."
    string entity
    string entity_id
    json before
    json after
  }
  refresh_tokens {
    int id PK
    int user_id FK
    string token_hash UK "SHA-256, не сам токен"
    timestamp expires_at
    timestamp revoked_at "ротация"
  }
  org_settings {
    int id PK "всегда 1"
    int conflict_threshold "процент отдела"
    string timezone
    string limit_policy "hard | soft"
    int default_planned_days
  }
  calendars {
    int year PK
    json holidays "праздники ст. 112"
    json transfers "переносы from → to"
  }
  email_outbox {
    int id PK
    int employee_id FK
    string to_address
    string kind "request_created, weekly_digest ..."
    string subject
    string status "pending | sent | failed"
    int attempts
    timestamp next_attempt_at "аренда и повтор"
  }
  job_runs {
    string name PK "weekly-digest"
    string period PK "неделя"
    timestamp ran_at
  }
  employees {
    int id PK
    string login UK
  }
