erDiagram
  employees |o--o{ audit_events : "актор"
  employees ||--o{ refresh_tokens : "сессии"
  audit_events {
    int id PK
    timestamp ts
    int actor_id FK
    string action "request.approved, employee.updated ..."
    string entity
    string entity_id
    json before
    json after
  }
  refresh_tokens {
    int id PK
    int user_id FK
    string token_hash UK "SHA-256, не сам токен"
    timestamp expires_at
    timestamp revoked_at "ротация"
  }
  org_settings {
    int id PK "всегда 1"
    int conflict_threshold "процент отдела"
    string timezone
    string limit_policy "hard | soft"
    int default_planned_days
  }
  calendars {
    int year PK
    json holidays "праздничные даты"
    json transfers "переносы выходных"
  }
  employees {
    int id PK
    string login UK
  }
